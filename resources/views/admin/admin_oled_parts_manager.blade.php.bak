<style>
/* 青枠＆ポッチ スタイル */
.part-frame-overlay {
    position: absolute !important;
    display: block !important;
    z-index: 1000 !important;
    cursor: move;
    box-sizing: border-box !important;
    background-color: rgba(0, 0, 255, 0.2) !important;
    border: none !important;
    box-shadow: 
        inset 0 0 0 3px #0000ff, 
        0 0 0 2px #ffffff,
        0 0 10px rgba(0, 0, 0, 0.5) !important;
}

.custom-edge-handle {
    position: absolute !important;
    width: 10px !important;
    height: 10px !important;
    background-color: #ffffff !important;
    border: 1px solid #0000ff !important;
    border-radius: 50% !important;
    box-sizing: border-box !important;
    z-index: 1010 !important;
    display: block !important;
}

.handle-nw { top: -5px !important; left: -5px !important; cursor: nw-resize !important; }
.handle-ne { top: -5px !important; right: -5px !important; cursor: ne-resize !important; }
.handle-sw { bottom: -5px !important; left: -5px !important; cursor: sw-resize !important; }
.handle-se { bottom: -5px !important; right: -5px !important; cursor: se-resize !important; }
.handle-n  { top: -5px !important; left: calc(50% - 5px) !important; cursor: n-resize !important; }
.handle-s  { bottom: -5px !important; left: calc(50% - 5px) !important; cursor: s-resize !important; }
.handle-w  { top: calc(50% - 5px) !important; left: -5px !important; cursor: w-resize !important; }
.handle-e  { top: calc(50% - 5px) !important; right: -5px !important; cursor: e-resize !important; }
</style>

@if(isset($selectedSheet))
<script>
document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('oled-part-form');
    const formTitle = document.getElementById('form-title');
    const formMethodField = document.getElementById('form-method-field');
    const inpName = document.getElementById('part-name');
    const inpCategory = document.getElementById('part-category');
    const inpX = document.getElementById('part-x');
    const inpY = document.getElementById('part-y');
    const inpW = document.getElementById('part-w');
    const inpH = document.getElementById('part-h');
    const btnSubmit = document.getElementById('btn-submit-part');
    const btnResetMode = document.getElementById('btn-reset-mode');
    
    const targetImg = document.getElementById('pixel-target-img');
    const canvasContainer = document.getElementById('pixel-canvas-container');
    const dragSelector = document.getElementById('pixel-drag-selector');
    const previewCanvas = document.getElementById('preview-canvas');
    const ctx = previewCanvas ? previewCanvas.getContext('2d') : null;
    
    const lblZoom = document.getElementById('lbl-zoom');
    const lblNaturalSize = document.getElementById('lbl-natural-size');
    const btnZoomIn = document.getElementById('btn-zoom-in');
    const btnZoomOut = document.getElementById('btn-zoom-out');
    const btnZoomReset = document.getElementById('btn-zoom-reset');

    let zoomLevel = 2.0;
    let mode = 'idle';
    let activeHandle = null;
    let startMouseX = 0, startMouseY = 0;
    let initialBoxRect = { x: 0, y: 0, w: 0, h: 0 };
    let isEditMode = false;
    let editPartId = null;

    function applyZoom(newZoom) {
        zoomLevel = Math.max(0.5, Math.min(8.0, newZoom));
        canvasContainer.style.zoom = zoomLevel;
        if (lblZoom) lblZoom.textContent = Math.round(zoomLevel * 100) + '%';
    }

    if (btnZoomIn) btnZoomIn.onclick = () => applyZoom(zoomLevel + 0.5);
    if (btnZoomOut) btnZoomOut.onclick = () => applyZoom(zoomLevel - 0.5);
    if (btnZoomReset) btnZoomReset.onclick = () => applyZoom(2.0);

    canvasContainer.parentElement.addEventListener('wheel', (e) => {
        if (e.ctrlKey) { 
            e.preventDefault(); 
            applyZoom(e.deltaY < 0 ? zoomLevel * 1.15 : zoomLevel / 1.15); 
        }
    }, { passive: false });

    function getCanvasPos(e) {
        const rect = canvasContainer.getBoundingClientRect();
        return {
            x: Math.floor((e.clientX - rect.left) / zoomLevel),
            y: Math.floor((e.clientY - rect.top) / zoomLevel)
        };
    }

    function drawPreview() {
        if (!ctx || !targetImg || targetImg.naturalWidth === 0) return;
        const x = parseInt(inpX.value) || 0;
        const y = parseInt(inpY.value) || 0;
        const w = parseInt(inpW.value) || 1;
        const h = parseInt(inpH.value) || 1;

        ctx.imageSmoothingEnabled = false;
        ctx.clearRect(0, 0, previewCanvas.width, previewCanvas.height);
        try {
            ctx.drawImage(targetImg, x, y, w, h, 0, 0, previewCanvas.width, previewCanvas.height);
        } catch(e) {}
    }

    function updateSelector(x, y, w, h) {
        const imgW = targetImg.naturalWidth || 9999;
        const imgH = targetImg.naturalHeight || 9999;

        x = Math.max(0, Math.min(imgW - 1, Math.floor(x)));
        y = Math.max(0, Math.min(imgH - 1, Math.floor(y)));
        w = Math.max(1, Math.min(imgW - x, Math.floor(w)));
        h = Math.max(1, Math.min(imgH - y, Math.floor(h)));

        inpX.value = x;
        inpY.value = y;
        inpW.value = w;
        inpH.value = h;

        dragSelector.style.left = x + 'px';
        dragSelector.style.top = y + 'px';
        dragSelector.style.width = w + 'px';
        dragSelector.style.height = h + 'px';
        drawPreview();
    }

    [inpX, inpY, inpW, inpH].forEach(inp => {
        if (inp) {
            inp.addEventListener('input', () => {
                const x = parseInt(inpX.value) || 0;
                const y = parseInt(inpY.value) || 0;
                const w = parseInt(inpW.value) || 1;
                const h = parseInt(inpH.value) || 1;
                dragSelector.style.left = x + 'px';
                dragSelector.style.top = y + 'px';
                dragSelector.style.width = w + 'px';
                dragSelector.style.height = h + 'px';
                drawPreview();
            });
        }
    });

    canvasContainer.addEventListener('mousedown', function(e) {
        if (e.button !== 0) return;
        const pos = getCanvasPos(e);
        const target = e.target;

        if (target.classList.contains('custom-edge-handle')) {
            mode = 'resizing';
            const handleClass = Array.from(target.classList).find(c => c.startsWith('handle-'));
            activeHandle = handleClass ? handleClass.replace('handle-', '') : 'se';
            startMouseX = pos.x;
            startMouseY = pos.y;
            initialBoxRect = {
                x: parseInt(dragSelector.style.left) || 0,
                y: parseInt(dragSelector.style.top) || 0,
                w: parseInt(dragSelector.style.width) || 16,
                h: parseInt(dragSelector.style.height) || 16
            };
            e.stopPropagation();
            return;
        }

        if (target === dragSelector || dragSelector.contains(target)) {
            mode = 'moving';
            startMouseX = pos.x;
            startMouseY = pos.y;
            initialBoxRect = {
                x: parseInt(dragSelector.style.left) || 0,
                y: parseInt(dragSelector.style.top) || 0,
                w: parseInt(dragSelector.style.width) || 16,
                h: parseInt(dragSelector.style.height) || 16
            };
            e.stopPropagation();
            return;
        }

        mode = 'creating';
        startMouseX = pos.x;
        startMouseY = pos.y;
        updateSelector(startMouseX, startMouseY, 1, 1);
        e.stopPropagation();
    });

    window.addEventListener('mousemove', function(e) {
        if (mode === 'idle') return;
        const pos = getCanvasPos(e);

        if (mode === 'creating') {
            let x = Math.min(startMouseX, pos.x);
            let y = Math.min(startMouseY, pos.y);
            let w = Math.abs(pos.x - startMouseX) + 1;
            let h = Math.abs(pos.y - startMouseY) + 1;
            updateSelector(x, y, w, h);
        } else if (mode === 'moving') {
            let dx = pos.x - startMouseX;
            let dy = pos.y - startMouseY;
            updateSelector(initialBoxRect.x + dx, initialBoxRect.y + dy, initialBoxRect.w, initialBoxRect.h);
        } else if (mode === 'resizing') {
            let rx = initialBoxRect.x, ry = initialBoxRect.y, rw = initialBoxRect.w, rh = initialBoxRect.h;
            let dx = pos.x - startMouseX, dy = pos.y - startMouseY;

            if (activeHandle.includes('n')) { ry += dy; rh -= dy; }
            if (activeHandle.includes('s')) { rh += dy; }
            if (activeHandle.includes('w')) { rx += dx; rw -= dx; }
            if (activeHandle.includes('e')) { rw += dx; }
            updateSelector(rx, ry, rw, rh);
        }
    });

    window.addEventListener('mouseup', () => { mode = 'idle'; activeHandle = null; });

    document.querySelectorAll('.oled-part-item').forEach(item => {
        item.addEventListener('click', function() {
            loadPart(this);
        });
    });

    function loadPart(item) {
        isEditMode = true;
        editPartId = item.dataset.id;
        inpName.value = item.dataset.name;
        inpCategory.value = item.dataset.category;
        
        updateSelector(item.dataset.x, item.dataset.y, item.dataset.w, item.dataset.h);

        formTitle.textContent = 'パーツ編集: ' + item.dataset.name;
        form.action = "{{ url('admin/oled-face/parts/update-part') }}/" + editPartId;
        formMethodField.value = 'PUT';
        btnSubmit.textContent = '更新する';
        btnResetMode.style.display = 'block';

        document.querySelectorAll('.oled-part-item').forEach(i => i.classList.remove('active'));
        item.classList.add('active');
    }

    if (btnResetMode) {
        btnResetMode.addEventListener('click', function() {
            isEditMode = false;
            editPartId = null;
            inpName.value = '';
            inpCategory.value = 'eye';
            formTitle.textContent = 'パーツ新規登録';
            form.action = "{{ route('admin.oled.parts.store_part') }}";
            formMethodField.value = 'POST';
            btnSubmit.textContent = '登録する';
            btnResetMode.style.display = 'none';
            document.querySelectorAll('.oled-part-item').forEach(i => i.classList.remove('active'));
        });
    }

    function init() {
        if (lblNaturalSize && targetImg) lblNaturalSize.textContent = targetImg.naturalWidth + '×' + targetImg.naturalHeight;
        applyZoom(2.0);
        updateSelector(0, 0, 16, 16);
    }

    if (targetImg) {
        if (targetImg.complete && targetImg.naturalWidth > 0) init();
        else targetImg.onload = init;
    }
});
</script>
@endif